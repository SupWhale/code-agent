# scripts/deploy_to_server.sh, scripts/rollback.sh가 --env-file이 아니라 `source .env.deploy`로
# 직접 읽습니다. 실제 값은 .env.deploy로 복사해서 채우고, .env.deploy는 절대 커밋하지 마세요
# (.gitignore에 이미 포함됨). 배포 대상 서버(예: LAN 서버)와 무관하게, 이 파일은 배포를
# "실행하는 쪽"(이 로컬 머신 또는 CI 러너)에만 있으면 됩니다.
#
# 사전 조건:
#   - 아래 SERVER_USER로 SERVER_HOST에 비밀번호 없이 SSH 접속이 가능해야 합니다
#     (ssh-copy-id 등으로 공개키 등록 — 스크립트에 비밀번호 프롬프트 처리가 없음).
#   - 배포하려는 커밋이 이미 origin/main에 push되어 있어야 합니다. deploy_to_server.sh는
#     `git rev-parse HEAD`를 이미지 태그로 써서 GHCR에서 그 태그를 pull하는데,
#     push 전이면 GitHub Actions(.github/workflows/build-and-push.yml)가 그 커밋용
#     이미지를 아직 안 만들었으므로 pull이 실패합니다.
#   - 대상 서버의 ${SERVER_PATH}/.env에 실제 API_KEYS/GRAFANA_ADMIN_PASSWORD/DOMAIN이
#     이미 채워져 있어야 컨테이너가 정상 기동합니다 (.env.example 참고).

# 필수 — 배포 대상 서버 SSH 접속 정보
SERVER_HOST=
SERVER_USER=
# 그 서버에 레포를 rsync로 둘 절대경로 (deployment/ 하위에서 docker compose를 실행함)
SERVER_PATH=

# 선택 — 기본값 있음
SERVER_PORT=22
# true면 로컬 pytest를 건너뛰고 바로 배포 (CI가 이미 통과시킨 커밋을 재배포할 때 등)
SKIP_TESTS=false
# 배포 전 서버의 기존 상태를 tar로 백업할지 여부 (SERVER_PATH/../backup, 7일 지나면 자동 삭제)
BACKUP_BEFORE_DEPLOY=true
