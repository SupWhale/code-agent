#!/usr/bin/env bash
# =============================================================================
# code-agent CLI 실행 파일
# 처음 실행 시 자동으로 의존성을 설치하고 CLI를 시작합니다.
# 사용법: ./agent [명령] [옵션]
#   ./agent status
#   ./agent session new
#   ./agent chat
#   ./agent ask "main.py 버그 수정해줘"
#
# PATH에 심볼릭 링크를 걸어 아무 디렉토리에서나 `agent`로 쓸 수도 있다:
#   ln -s "$(pwd)/agent" /opt/homebrew/bin/agent
# =============================================================================

set -e

# 심볼릭 링크를 통해 실행돼도 실제 저장소 위치를 찾아야 한다.
# dirname "${BASH_SOURCE[0]}"만 쓰면 링크가 놓인 디렉토리(예: /opt/homebrew/bin)를
# 가리켜 cli/.venv를 못 찾는다. macOS의 BSD readlink에는 -f가 없는 버전이 있어
# 직접 링크를 따라간다.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  # 상대 링크면 링크가 있던 디렉토리 기준으로 풀어준다
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$LINK_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VENV_DIR="$SCRIPT_DIR/cli/.venv"
REQUIREMENTS="$SCRIPT_DIR/cli/requirements.txt"
MARKER="$VENV_DIR/.installed"

# ── 색상 출력 ──────────────────────────────────────────────────────────────
_info()  { echo -e "\033[1;34m[agent]\033[0m $*"; }
_ok()    { echo -e "\033[1;32m[agent]\033[0m $*"; }
_err()   { echo -e "\033[1;31m[agent]\033[0m $*" >&2; }

# ── Python 확인 ────────────────────────────────────────────────────────────
PYTHON=""
for cmd in python3 python; do
  if command -v "$cmd" &>/dev/null; then
    ver=$("$cmd" -c "import sys; print(sys.version_info >= (3,9))" 2>/dev/null)
    if [ "$ver" = "True" ]; then
      PYTHON="$cmd"
      break
    fi
  fi
done

if [ -z "$PYTHON" ]; then
  _err "Python 3.9 이상이 필요합니다. https://python.org 에서 설치하세요."
  exit 1
fi

# ── 초기 설치 (최초 1회) ───────────────────────────────────────────────────
if [ ! -f "$MARKER" ]; then
  _info "초기 설정 중 (최초 1회만 실행됩니다)..."

  _info "가상환경 생성: $VENV_DIR"
  "$PYTHON" -m venv "$VENV_DIR"

  _info "의존성 설치 중..."
  "$VENV_DIR/bin/pip" install --upgrade pip -q
  "$VENV_DIR/bin/pip" install -r "$REQUIREMENTS" -q

  touch "$MARKER"
  _ok "설치 완료!"
  echo ""
fi

# ── requirements.txt 변경 시 재설치 ────────────────────────────────────────
if [ "$REQUIREMENTS" -nt "$MARKER" ]; then
  _info "requirements.txt 변경 감지 — 의존성 재설치 중..."
  "$VENV_DIR/bin/pip" install -r "$REQUIREMENTS" -q
  touch "$MARKER"
fi

# ── CLI 실행 ───────────────────────────────────────────────────────────────
# 사용자의 현재 디렉토리를 그대로 유지한 채 실행한다. 예전에는 `cd "$SCRIPT_DIR"`로
# 옮긴 뒤 실행했는데, `files sync`/`files local-ls`/`files pull`이 인자를 생략하면
# Path.cwd()를 기본값으로 쓰기 때문에 어느 디렉토리에서 실행하든 항상 이 저장소를
# 대상으로 동작해버렸다 (다른 프로젝트에서 `agent files sync`를 하면 그 프로젝트가
# 아니라 code-agent 저장소가 업로드됨). cd 대신 PYTHONPATH로 cli 패키지를 찾게 한다.
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_DIR/bin/python" -m cli.main "$@"
