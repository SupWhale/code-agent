FROM python:3.11-slim

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 curl 설치 (헬스체크용)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Python 의존성 복사 및 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스 코드 및 필요한 파일 복사
COPY src/ ./src/
COPY prompts/ ./prompts/

# workspace 디렉토리 생성 (볼륨 마운트 대비). 호스트 바인드 마운트의 UID가
# 컨테이너 사용자와 다를 수 있어 777로 열어둔다 — /app(코드)은 그대로 소유권 제한.
RUN mkdir -p /workspace && chmod 777 /workspace

# 비특권 사용자로 실행 (컨테이너가 root로 동작하지 않도록)
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser && \
    chown -R appuser:appuser /app
USER appuser

# 환경 변수
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 포트 노출
EXPOSE 8000

# 애플리케이션 실행 (WORKERS/API_PORT 환경 변수로 오버라이드 가능, 기본값은 WORKERS=1)
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${API_PORT:-8000} --workers ${WORKERS:-1} --timeout-graceful-shutdown 25"]
