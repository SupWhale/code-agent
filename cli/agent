#!/usr/bin/env bash
# =============================================================================
# PATH에 심볼릭 링크로 걸어 아무 디렉토리에서나 `agent`로 쓰기 위한 진입점.
#
#   sudo ln -s /path/to/code-agent/cli/agent /usr/local/bin/agent
#
# 실제 로직(venv 부트스트랩, 의존성 재설치, 실행)은 저장소 루트의 `agent`에 있고
# 여기서는 그쪽으로 위임만 한다. 예전에는 이 파일이 저장소 경로를 하드코딩하고
# 직접 `cd` 후 python을 실행했는데, 그 방식은 두 가지 문제가 있었다:
#   1) 경로가 특정 머신에 고정돼 다른 곳에 체크아웃하면 동작하지 않음
#   2) `cd` 때문에 사용자의 현재 디렉토리가 버려져서, 인자를 생략하면 cwd를 쓰는
#      `files sync`/`files local-ls`/`files pull`이 항상 이 저장소를 대상으로 동작
#      (다른 프로젝트에서 `agent files sync`를 하면 그 프로젝트가 아니라
#       code-agent 저장소가 업로드됐다 — 실측 확인)
# =============================================================================

set -e

# 심볼릭 링크(예: /usr/local/bin/agent)를 통해 실행되므로 실제 파일 위치를 찾아간다.
# macOS의 BSD readlink에는 -f가 없는 버전이 있어 직접 링크를 따라간다.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  # 상대 링크면 링크가 있던 디렉토리 기준으로 풀어준다
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$LINK_DIR/$SOURCE"
done
CLI_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# 현재 디렉토리는 그대로 둔 채 루트 런처에 넘긴다 (cd 하지 않는 것이 핵심).
exec "$CLI_DIR/../agent" "$@"
