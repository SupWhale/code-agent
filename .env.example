# deployment/docker-compose.yml 이 --env-file로 이 파일을 읽어 컨테이너 환경 변수를 채웁니다.
# 실제 값은 .env로 복사해서 채우고, .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함됨).

OLLAMA_HOST=http://ollama:11434
MODEL_NAME=qwen2.5-coder:7b
API_PORT=8000
LOG_LEVEL=INFO
WORKSPACE_PATH=/workspace
MAX_FILE_SIZE=104857600

# 단일 프로세스 가정 (TaskManager/SessionManager가 아직 프로세스 메모리 상태이므로
# 1보다 크게 설정하면 워커마다 다른 상태를 보게 됨 — Redis 도입 전까지 1 유지)
WORKERS=1

# production이면 API_KEYS가 비어 있을 때 기동이 즉시 실패합니다 (fail-fast).
# 로컬에서 인증 없이 띄우려면 development로 바꾸세요.
ENVIRONMENT=production

# 콤마로 구분된 "키:scope" 목록. scope는 user 또는 admin.
# admin 키만 /api/v1/files/upload, /api/v1/files/delete 같은 공유 워크스페이스 전역 조작이 가능합니다.
# 예: openssl rand -hex 32 로 토큰을 생성해 사용하세요.
API_KEYS=

# 브라우저에서 크로스오리진으로 접근을 허용할 origin (콤마 구분). CLI/서버 간 통신에는 필요 없습니다.
CORS_ALLOWED_ORIGINS=

# 임의 셸 명령 실행(run_command) 도구를 공개 API에 노출할지 여부. 외부 공개 배포에서는 false 유지.
ENABLE_SHELL_TOOL=false

# API 키(또는 IP) 기준 분당 요청 허용 횟수 (/api/v1/generate, 작업 생성/실행, WebSocket 연결 시도)
RATE_LIMIT_PER_MINUTE=30

# Grafana 관리자 비밀번호. 기본값 없음 — 반드시 직접 설정해야 컨테이너가 기동합니다.
GRAFANA_ADMIN_PASSWORD=

# TLS(Let's Encrypt)용. DOMAIN은 이 서버를 가리키는 실제 공인 도메인이어야 하며,
# scripts/init_letsencrypt.sh 로 최초 인증서를 발급받기 전까지 nginx 서비스는 기동되지 않습니다.
DOMAIN=
LETSENCRYPT_EMAIL=
